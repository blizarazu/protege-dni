{
  "name": "protege-dni",
  "private": true,
  "version": "0.1.0",
  "description": "Marca de agua y ocultación de datos para copias del DNI, 100 % en el navegador.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copiar-pdfjs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copiar-pdfjs.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "pretest": "node scripts/copiar-pdfjs.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
